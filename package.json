{
  "name": "clasifacil-server",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon --exec ts-node src/container/inversify.config.ts",
    "dev:local": "cross-env NODE_ENV=local nodemon --exec ts-node src/container/inversify.config.ts",
    "dev:prod": "cross-env NODE_ENV=prod nodemon --exec ts-node src/container/inversify.config.ts",
    "build": "tsc",
    "start": "node dist/container/inversify.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "inversify": "^8.2.3",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
